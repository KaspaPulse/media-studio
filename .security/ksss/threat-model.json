{
  "version": "1.0.0",
  "repository": "KaspaPulse/media-studio",
  "surfaces": [
    "local media input, URL input, and remote media acquisition",
    "yt-dlp helper execution",
    "FFprobe media inspection",
    "FFmpeg transcoding",
    "local output filesystem",
    "desktop GUI and settings",
    "release artifact and helper-tool supply chain"
  ],
  "assets": [
    "local and downloaded source media",
    "generated media outputs, including WhatsApp-profile clips",
    "user-selected output paths",
    "application settings",
    "packaged executable and release artifacts",
    "external helper executables and their identities"
  ],
  "trust_boundaries": [
    {
      "from": "user URL input",
      "to": "yt-dlp process",
      "requirements": ["http/https validation", "structured argument arrays", "no shell command construction"]
    },
    {
      "from": "local or downloaded media",
      "to": "FFprobe/FFmpeg",
      "requirements": ["read-only local source handling", "bounded output directory", "explicit stream mapping", "profile-scoped output verification"]
    },
    {
      "from": "application",
      "to": "local filesystem",
      "requirements": ["preserve original source", "dedicated per-job directories", "no destructive source mutation"]
    },
    {
      "from": "source tree",
      "to": "release artifact",
      "requirements": ["locked dependencies", "exact source identity", "SBOM/provenance before release", "pinned external Actions"]
    }
  ]
}
